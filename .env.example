# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — ASSESSMENT 2 (PAYMENTS & SUBSCRIPTION)
# Provider: Flutterwave Test Mode
# ==============================================================================

# Database Connection: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/assessment_payments?schema=public"

# Base Application URL: Used for redirect return endpoints
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Secret: Used for session encryption/HMAC hashing
AUTH_SECRET="change-me-to-a-secure-random-32-byte-hex-string"

# Flutterwave API Keys (Test Mode)
# Sourced from Flutterwave Dashboard: Settings -> API Keys
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx"
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx"
FLW_ENCRYPTION_KEY="FLWSECK_TEST_xxxxxxxxxxxx"

# Flutterwave Webhook Secret Hash
# Configured in Flutterwave Dashboard: Settings -> Webhooks -> "Secret hash"
# Flutterwave sends this value in the 'verif-hash' header on every webhook request
FLW_SECRET_HASH="custom-webhook-secret-hash-for-signature-verification"

# Currency & Minor-Unit Plan Pricing
# Monetary values MUST be whole integers in minor units (e.g. 500000 = 5,000.00 NGN)
CURRENCY="NGN"
PLAN_MONTHLY_MINOR=500000
PLAN_YEARLY_MINOR=5000000

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV="development"

# Provider Simulation (DEVELOPMENT/EVALUATOR ONLY)
# When "true", checkout initiation and transaction verification are served from our
# own payment_events ledger instead of calling Flutterwave, so the subscription
# lifecycle can be exercised without moving money. Always ignored when
# NODE_ENV="production". Never enable this on a deployed environment: with it on,
# no real charge is ever required.
PAYMENTS_SIMULATE="false"
